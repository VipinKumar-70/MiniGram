<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | MiniGram</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="bg-zinc-950 text-white min-h-screen">
    <!-- Navbar -->
    <nav
      class="w-full px-10 py-5 border-b border-white/10 flex justify-between items-center"
    >
      <h1 class="text-xl font-bold"><a href="/">MiniGram</a></h1>

      <div class="flex gap-4">
        <a href="/feed" class="bg-blue-500 px-4 py-2 rounded-lg">Feed</a>

        <a href="/dashboard" class="bg-blue-500 px-4 py-2 rounded-lg"
          >Profile</a
        >

        <a href="/logout" class="bg-red-500 px-4 py-2 rounded-lg">Logout</a>
      </div>
    </nav>

    <!-- Public feed -->
  <section class="p-10">

  <div class="max-w-2xl mx-auto space-y-10">

    <% allPost.forEach(function(posts){ %>

    <div class="bg-zinc-900 rounded-xl border border-white/10 overflow-hidden">

      <!-- User Header -->
      <div class="flex items-center gap-3 p-4 border-b border-white/10">
        <div class="w-10 h-10 rounded-full bg-zinc-700 flex items-center justify-center">
          <span class="font-bold">
            <%= posts.user.username.charAt(0).toUpperCase() %>
          </span>
        </div>

        <h2 class="font-semibold capitalize">
          <a href="/user/<%= posts.user._id%>"><%= posts.user.username %></a>
        </h2>
      </div>

      <!-- Image -->
      <% if(posts.image){ %>
        <img
          src="/uploads/<%= posts.image %>"
          class="w-full h-96 object-cover"
        />
      <% } else { %>
        <div class="w-full h-96 bg-zinc-800 flex items-center justify-center text-zinc-400">
          No Image
        </div>
      <% } %>

      <!-- Caption -->
      <div class="p-4">
        <p class="text-sm text-zinc-300">
          <%= posts.caption %>
        </p>
      </div>

    </div>

    <% }) %>

  </div>

</section>

  </body>
</html>
